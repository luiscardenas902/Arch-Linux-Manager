trap 's=$?; echo "$0: Error on line "$LINENO": $BASH_COMMAND"; exit $s' ERR

ARCH_BACKTITLE="Arch Installation Manager"

welcome(){ 
	dialog --backtitle "$ARCH_BACKTITLE" \
	--title "Welcome" \
	--msgbox "Welcome to the Arch Installer Manager!" 0 0
}

get_hostname(){ 
	local hostname
	local regex='^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$'

	while true; do
		hostname=$(dialog --backtitle "$ARCH_BACKTITLE" \
		--title "Hostname" \
		--inputbox "Please type the hostname" 0 0 \
		--stdout) || { clear; exit 1; }

		if [[ $hostname =~ $regex ]]; then #regular expression comparator ie az1-a
			HOSTNAME_USER_INPUT=$hostname 
			break
		fi

		dialog --backtitle "$ARCH_BACKTITLE" \
		--title "Invalid Hostname" \
		--msgbox "Hostnames can only contain letters a through z, A through Z, digits 0 through 9 and the hyphen-minus character ('-'). It cannot start or end with a hyphen. It may not be longer than 63 characters." 0 0 
		
	done
}

get_login(){
	local root_password
	local root_confirm
	local user_name
	local user_password
	local regex='^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$'

	while true; do
		root_password=$(dialog --stdout --backtitle "$ARCH_BACKTITLE" \
		--title "Root Password" --insecure \
		--passwordbox "Please type the root password: " 0 0) || { clear; exit 1; }

		if [[ -z "$root_password" ]]; then 
			dialog --backtitle "$ARCH_BACKTITLE" \
			--title "Invalid Password" \
			--msgbox "Password cannot be blank. Please enter a password." 0 0 
		fi	

		root_confirm=$(dialog --stdout --backtitle "$ARCH_BACKTITLE" \
		--title "Confirm Root Password" --insecure \
		--passwordbox "Please type the root password again: " 0 0) || { clear; exit 1; }

		if [[ $root_password == $root_confirm ]]; then
			ROOT_PASSWORD_USER_INPUT=$root_password
			break
		else
			dialog --backtitle "$ARCH_BACKTITLE" \
			--title "Incorrect Password" \
			--msgbox "Password does not match. Please try again" 0 0 
		fi
	done

	username=$(dialog --backtitle "$ARCH_BACKTITLE" \
	--title "Username" \
	--inputbox "Please type the username" 0 0 \
	--stdout) || { clear; exit 1; }

	while true; do

		if [[ $username =~ $regex ]]; then #regular expression comparator ie az1-9
			USERNAME_USER_INPUT=$username 
		else
			dialog --backtitle "$ARCH_BACKTITLE" \
			--title "Invalid Username" \
			--msgbox "Usernames can only contain letters a through z, A through Z, digits 0 through 9 and the hyphen-minus character ('-'). They	 cannot start or end with a hyphen. It may not be longer than 63 characters." 0 0 
		fi			
			
		user_password=$(dialog --stdout --backtitle "$ARCH_BACKTITLE" \
		--title "User Password" --insecure \
		--passwordbox "Please type the user's password: " 0 0) || { clear; exit 1; }

		if [[ -z "$user_password" ]]; then 
			dialog --backtitle "$ARCH_BACKTITLE" \
			--title "Invalid Password" \
			--msgbox "Password cannot be blank. Please enter a password." 0 0 
		fi

		user_confirm=$(dialog --stdout --backtitle "$ARCH_BACKTITLE" \
		--title "Confirm User Password" --insecure \
		--passwordbox "Please type the user password again: " 0 0) || { clear; exit 1; }

		if [[ $user_password == $user_confirm ]]; then
			USER_PASSWORD_USER_INPUT=$user_password
			break
		else
			dialog --backtitle "$ARCH_BACKTITLE" \
			--title "Incorrect Password" \
			--msgbox "Password does not match. Please try again" 0 0 
		fi
	done
}

