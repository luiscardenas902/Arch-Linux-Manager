welcome(){ 
	dialog --backtitle "Arch Installer Manager" \
	--title "Welcome" \
	--msgbox "Welcome to the Arch Installer Manager!" 0 0
}
welcome


get_hostname(){ 
	local hostname
	local regex='^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$'

	while true; do
	hostname=$(dialog --backtitle "Arch Installer Manager" \
	--title "Hostname" \
	--inputbox "Please type the hostname: " 0 0 \
	--stdout) || { clear; exit 1; }

	if [[ $hostname =~ $regex ]]; then
		HOSTNAME_USER_INPUT=$hostname
		break
	fi

	dialog --backtitle "Arch Installer Manager" \
	--title "Invalid Hostname" \
	--msgbox "Hostnames can only contain letters a through z, digits 0 through 9 and the hyphen-minus character ('-'). It cannot start or end with a hyphen. It may not be longer than 63 characters." 0 0 
	
	done
}
get_hostname

test(){ 
